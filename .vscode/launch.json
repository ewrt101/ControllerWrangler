{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": 
    [   
        // Attach to ControllerWrangler.exe for debugging
        {
            "name": ".NET Core Attach to ControllerWrangler",
            "type": "coreclr",
            "request": "attach",
            "processName": "ControllerWrangler.exe"
        },
        // Launch the application using dotnet run for debugging
        {
            "name": ".NET Core Launch (ControllerWrangler)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/ControllerWrangler.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        }
    ]
}